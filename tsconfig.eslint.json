{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["ES2022", "DOM"],
        "strict": false,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "allowJs": false,
        "noEmit": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules/**"]
}
