{
    "name": "eq-questionnaire-runner",
    "version": "1.0.0",
    "description": "ONS Digital eQ Questionnaire Runner App",
    "type": "module",
    "author": {
        "name": "ONS Digital",
        "url": "http://onsdigital.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ONSdigital/census31-eq-questionnaire-runner"
    },
    "scripts": {
        "format": "npm run format:tests && npm run format:test-schemas",
        "format:tests": "prettier 'tests/functional/**/*.ts' --write && eslint --fix 'tests/functional/**/*.ts' && ts-standard --fix '**/*.ts'",
        "format:test-schemas": "prettier 'schemas/test/*/*.json' --write && eslint --fix 'schemas/test/**/*.json'",
        "lint": "npm run lint:tests && npm run lint:test-schemas",
        "lint:tests": "eslint 'tests/functional/**/*.ts' eslint.config.js && ts-standard 'tests/functional/**/*.ts'",
        "lint:test-schemas": "prettier --check 'schemas/test/**/*.json' && eslint 'schemas/test/**/*.json'"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.61.1",
        "@typescript-eslint/eslint-plugin": "8.60.1",
        "@typescript-eslint/parser": "8.60.1",
        "eslint": "10.6.0",
        "eslint-cli": "1.1.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-json": "4.0.1",
        "eslint-plugin-n": "17.23.1",
        "eslint-plugin-node": "11.1.0",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-promise": "7.3.0",
        "globals": "17.7.0",
        "json-web-key": "0.4.0",
        "jsrsasign": "11.1.3",
        "node-forge": "1.4.0",
        "node-jose": "2.2.0",
        "prettier": "3.8.3",
        "ts-standard": "12.0.2",
        "typescript": "6.0.3",
        "uuid": "14.0.1"
    },
    "prettier": {
        "printWidth": 160
    },
    "ts-standard": {
        "project": "tsconfig.eslint.json"
    }
}
